# Дерекқор: жергілікті Postgres немесе Supabase → Project Settings → Database → Connection string (Transaction pooler)
DATABASE_URL=postgres://app:app@localhost:5432/adebietlab

# Cookie қолтаңбасына арналған кездейсоқ ұзын жол: `openssl rand -base64 32`
AUTH_SECRET=

# ЖИ. AI_MOCK=true болса, кілт керек емес: сайт ережемен жасалған демо жауаптармен жұмыс істейді.
AI_MOCK=true
# gemini | groq | openai (кез келген OpenAI-үйлесімді API, AI_BASE_URL қажет)
AI_PROVIDER=gemini
AI_API_KEY=
# Gemini: модель атауын aistudio.google.com беттегі тізімнен тексеріңіз, мысалы gemini-flash-latest
# Groq: openai/gpt-oss-120b
AI_MODEL=gemini-flash-latest
AI_BASE_URL=
AI_DAILY_LIMIT_STUDENT=30
